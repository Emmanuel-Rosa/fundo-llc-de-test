# Copy to .env before the first `docker compose up`:
#     cp .env.example .env          (PowerShell: Copy-Item .env.example .env)
#
# SQL Server rejects a password that fails its complexity rules by exiting during
# startup, which reads as "the image is broken" rather than "the password is weak".
# 8+ chars with three of: uppercase, lowercase, digit, symbol.
MSSQL_SA_PASSWORD=Fundo_Exercise_2026!
